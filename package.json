{
  "name": "prepkit",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Turns a job description + company URL into a personalised interview prep kit",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "evaluate": "tsx scripts/evaluate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:api": "npm run dev -w @prepkit/api",
    "dev:web": "npm run dev -w @prepkit/web",
    "fixtures": "tsx scripts/fixture-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
