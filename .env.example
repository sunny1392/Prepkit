# ---------- LLM ----------
# OpenRouter key (https://openrouter.ai/keys). Only ":free" models are used.
OPENROUTER_API_KEY=
# Comma-separated fallback chain of OpenRouter free models, tried in order on 429/5xx/bad JSON.
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free
# Google AI Studio key (https://aistudio.google.com/apikey). Backup provider; optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Order providers are tried in. Providers with no key are skipped.
LLM_PROVIDER_ORDER=openrouter,gemini
# Requests per minute ceiling across all LLM calls (free tiers are ~15-20 RPM).
LLM_RPM=15

# ---------- Retrieval ----------
# Allow fetching private/loopback hosts (localhost etc). Must be false on a public deployment.
# `npm run evaluate` forces this to true because evaluation sites may be served from localhost.
ALLOW_PRIVATE_HOSTS=false
# Max pages crawled per company site.
CRAWL_MAX_PAGES=12

# ---------- API ----------
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit
# Long random string used to sign session tokens.
JWT_SECRET=change-me
# Origin of the web app, for CORS + cookies.
CORS_ORIGIN=http://localhost:3000
# Only needed if the browser calls the API directly on another site (we proxy via Next, so normally false).
CROSS_SITE_COOKIES=false
# Parallel kit generations per API process (they share one LLM rate limit).
JOB_CONCURRENCY=2

# ---------- Web (apps/web) ----------
# Where the Next.js server proxies /api/* to. Server-side only; the browser never sees it.
API_URL=http://localhost:4000
